# Raw third-party downloads (PDFs, HTML, renders). Kept locally for re-verification, never committed or
# redistributed: rights differ per source (see manifests/rights_and_attribution.csv). Checksums are in
# manifests/data_sources.csv so any copy can be re-identified.
_raw/

__pycache__/
*.pyc
.env
.env.*
!.env.example
*.env
*.pem
*.key
.secrets/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Third-party source downloads and private evaluation state remain local.
DOCS/*.pdf
web/eval/
web/artifacts/*.zip

# Local tools and build caches are never team source.
node_modules/
.next/
*.tsbuildinfo
test-results/
playwright-report/

# Local agent settings, working notes and submission drafts are not public source.
.claude/
.codex/
.agents/
CLAUDE.md
AGENTS.md
BLOCKERS.md
CHRONOLOGY.md
DECISIONS.md
IGNIS_SUBMISSION_ANSWERS_*.md
