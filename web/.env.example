# Safe defaults. Empty configuration means DISABLED, not a fallback provider. Secrets are injected separately.
AI_ENABLED=false
AI_MODE=disabled
AI_PROVIDER=none
AI_MODEL=
AI_RUNTIME_CONFIG_REVISION=unselected
AI_PRICE_RECORD_ID=
AI_AUTHORIZATION_ID=
AI_USD_CAP=0
AI_LOGICAL_CALL_CAP=0
AI_ATTEMPT_CAP=0
AI_MAX_INPUT_TOKENS=12000
AI_MAX_GENERATED_TOKENS=2048
AI_MAX_CONCURRENT=1
AI_ATTEMPT_TIMEOUT_MS=12000
AI_INTERACTION_TIMEOUT_MS=25000
BUDGET_DB_PATH=
LOG_USER_TEXT=false
ALLOW_RUNTIME_WEB_FETCH=false
ALLOW_UPLOADS=false

# Cloudflare SI gateway. Backend only. Flags/keys cannot bypass semantic acceptance.
CF_SI_ENABLED=false
CF_SI_MODE=local
CF_ACCOUNT_ID=
CF_AI_GATEWAY_ID=webiste-chatbot
# Server-only value. For Node staging, a private .env.production.local can supply it.
# Keep that file outside public/; never use a NEXT_PUBLIC_ prefix for credentials.
CF_AI_GATEWAY_TOKEN=
CF_SI_SIGNING_KEY=
# Absolute path to durable storage outside the repository/public assets.
CF_SI_QUOTA_DB=
CF_SI_APP_ORIGIN=http://127.0.0.1:3000
CF_BYOK_ONLY_VERIFIED=false
CF_PRIVACY_SETTINGS_VERIFIED=false
CF_SHARED_QUOTA_STORE_VERIFIED=false
CF_GROQ_FREE_VERIFIED=false
CF_OPENROUTER_FREE_VERIFIED=false
# Public mode additionally requires a replacement token, HTTPS and Turnstile.
CF_TOKEN_ROTATED=false
CF_TURNSTILE_SECRET=
CF_TURNSTILE_SITE_KEY=
