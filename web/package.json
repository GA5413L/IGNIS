{
  "name": "ignis-web",
  "version": "0.1.0",
  "private": true,
  "description": "IGNIS: NASA microgravity fire research workspace (Emberfall, NASA Space Apps 2026). Research, data curation, design and code developed with Claude Code and OpenAI Codex assistance; see docs/AI_DISCLOSURE.md. Not affiliated with or endorsed by NASA.",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev --webpack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "tsx scripts/validate-catalog.ts",
    "audit:design": "tsx scripts/audit-design.ts",
    "audit:endpoints": "tsx scripts/audit-endpoints.ts",
    "calculate:trajectory": "tsx scripts/calculate-trajectory.ts",
    "inspect:local": "tsx scripts/inspect-local-data.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:exports": "vitest run tests/exports",
    "test:team": "vitest run tests/unit tests/integration tests/exports --exclude tests/unit/providers.test.ts",
    "test:e2e": "playwright test",
    "build": "next build --webpack",
    "start": "next start -p 3000"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
